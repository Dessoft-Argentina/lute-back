# ============================================
# Backend de Lute — Ejemplo de variables de entorno
# Copiar a env/development.env y completar con valores reales
# NUNCA committear env/development.env con secretos reales
# ============================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor
PORT=4000

# Base de datos PostgreSQL
DB_NAME=lute
DB_USER=postgres
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# JWT (único secreto para firma y verificación)
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=15m

# Cookie
COOKIE_SECRET=change-this-to-a-random-secret

# Mercado Pago — Access Token (producción o test)
MP_ACCESS_TOKEN=APP_USR-xxxxx-xxxxxxxx
MP_WEBHOOK_SECRET=change-this-to-a-webhook-secret

# CORS — orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# URLs públicas del storefront y admin
PUBLIC_STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
